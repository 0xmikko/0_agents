#!/usr/bin/env bash
# Managed entrypoint for installing/checking the private code-production stack.
set -euo pipefail

# @tested-by: tst_unit_planctl_package_001
SOURCE_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
REPO_DIR="$(cd "$(dirname "$SOURCE_PATH")/.." && pwd)"
exec bun "$REPO_DIR/shared/code-production/agent-stack.ts" "$@"
